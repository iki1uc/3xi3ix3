// ======================================================
// 64SPLIT — Algorithmische Version
// ======================================================

export const SPLIT128 = {

  // -----------------------------
  // 1) R128 → R64quant + R64syn
  // -----------------------------
  R128(x) {
    return {
      quant: this.R64_quant(x),
      syn: this.R64_syn(x),
      use: "R128use"
    };
  },

  R64_quant(x) {
    return {
      tag: "64quant",
      value: x,
      tmp: false,
      sync: false
    };
  },

  R64_syn(x) {
    return {
      tag: "64syn",
      value: x,
      tmp: true,
      sync: true
    };
  },

  // -----------------------------
  // 2) U128 → U64(6E) ∥ U64(6D)
  // -----------------------------
  U128(x) {
    return {
      "6E": this.U64_6E(x),
      "6D": this.U64_6D(x),
      lock: true,        // verhindert Drift
      parallel: true     // echte Parallelität
    };
  },

  U64_6E(x) {
    return {
      tag: "6E",
      value: x,
      optimize: true,
      tmp: false
    };
