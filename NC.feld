// ======================================================
// NC.feld — iki1uc TRANSWARB-Relevanzfeld
// ======================================================

export const NC_feld = {

  // --------------------------------------------------
  // 1) CONTINUUM — OST / WEST / NORD / SÜD
  // --------------------------------------------------
  CONTINUUM: {

    NORD: {
      axis: "+Y",
      mode: "VERDICHTUNG",
      chain: [27, 81],
      bind: "AIR"
    },

    SÜD: {
      axis: "-Y",
      mode: "ABLEITUNG",
      chain: [81, 27, 3],
      bind: "6E6D"
    },

    OST: {
      axis: "+X",
      mode: "EXPANSION",
      chain: [3, 9, 27],
      bind: "XyX"
    },

    WEST: {
      axis: "-X",
      mode: "KONTRAKTION",
      chain: [27, 9, 3],
      bind: "AIV"
    },

    PREFETCH: {
      window3x2: [
        [3, 9],
        [27, 81],
        [243, 729]
      ],
      sync: true,
      mode: "ULTRA"
    }
  },

  // --------------------------------------------------
  // 2) Ableitung 3e = XyX + AIR + AIV
  // --------------------------------------------------
  derive(XyX, AIR, AIV) {
    return XyX + AIR + AIV;
  },

  // --------------------------------------------------
  // 3) Verdichtungskette (3 → 27 → 81 → 243 → 729)
  // --------------------------------------------------
  chain(x = 3) {
    return {
      base: x,
      cube3: x ** 3,     // 27
      nc: 81,            // NC.feld
      expand: 81 * 3,    // 243
      cube9: 9 ** 3      // 729
    };
  },

  // --------------------------------------------------
  // 4) NC.feld = 81 / 3e
  // --------------------------------------------------
  field(threeE) {
    return 81 / threeE;
  },

  // --------------------------------------------------
  // 5) TRANSWARB — Beweisfeld
  // ------------------------------------------------
